# ==============================================================================
# Malume Platform — Cross-Platform Line Ending & Binary Rules
# Ensures Windows (Visual Studio) and Linux (Docker / GitHub Actions) stay consistent.
# ==============================================================================

* text=auto eol=lf

# .NET & Visual Studio
*.cs          text diff=csharp eol=lf
*.csx         text diff=csharp eol=lf
*.csproj      text eol=lf
*.vbproj      text eol=lf
*.fsproj      text eol=lf
*.sln         text eol=lf
*.slnx        text eol=lf
*.props       text eol=lf
*.targets     text eol=lf
*.razor       text eol=lf
*.cshtml      text eol=lf
*.resx        text eol=lf
*.config      text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.xml         text eol=lf
*.sql         text eol=lf

# Web & Mobile Source
*.html        text eol=lf
*.css         text eol=lf
*.scss        text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.kt          text eol=lf
*.kts         text eol=lf
*.java        text eol=lf
*.gradle      text eol=lf
*.properties  text eol=lf

# Docs, Containers & Scripts
*.md          text eol=lf
*.sh          text eol=lf
Dockerfile*   text eol=lf
gradlew       text eol=lf
.editorconfig text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Windows-specific scripts
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# Binary files
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.webp        binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.eot         binary
*.pdf         binary
*.jar         binary
*.keystore    binary
*.jks         binary
*.pfx         binary
*.dll         binary
*.exe         binary
*.zip         binary
*.gz          binary
