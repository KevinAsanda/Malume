{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Hangfire": {
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "Malume.Api",
    "Audience": "Malume.Clients",
    "AccessTokenExpirationMinutes": 60
  }
}
