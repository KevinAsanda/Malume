@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Malume Portal</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <AuthorizeView Roles="@MalumeRoles.SysAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/compliance">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Compliance Review
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@MalumeRoles.FleetOwner">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="fleet">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Fleet
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@MalumeRoles.SchoolAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="school">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> School
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@(MalumeRoles.SchoolAdmin + "," + MalumeRoles.SysAdmin)">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="school/gate-board">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Live Gate Board
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@(MalumeRoles.FleetOwner + "," + MalumeRoles.SysAdmin)">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="escrow">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Escrow &amp; Ledger
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-3">
                    <button class="btn btn-outline-light btn-sm w-100" @onclick="LogoutAsync">
                        Logout (@context.User.Identity?.Name)
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool _collapseNavMenu = true;

    private string? NavMenuCssClass => _collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        _collapseNavMenu = !_collapseNavMenu;
    }

    private async Task LogoutAsync()
    {
        await AuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
