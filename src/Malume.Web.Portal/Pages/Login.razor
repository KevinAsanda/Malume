@page "/login"
@using System.ComponentModel.DataAnnotations
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login — Malume Portal</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title mb-3">Sign in to Malume</h3>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@_errorMessage</div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small" />

                    <div class="mb-3">
                        <label class="form-label" for="loginEmail">Email</label>
                        <InputText id="loginEmail" class="form-control" @bind-Value="_model.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="loginPassword">Password</label>
                        <InputText id="loginPassword" type="password" class="form-control" @bind-Value="_model.Password" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Signing in..." : "Sign in")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginFormModel _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleLoginAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            bool succeeded = await AuthStateProvider.LoginAsync(new LoginRequest(_model.Email, _model.Password));
            if (succeeded)
            {
                Navigation.NavigateTo("");
            }
            else
            {
                _errorMessage = "Invalid email or password.";
            }
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Unable to reach Malume.Api: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class LoginFormModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
