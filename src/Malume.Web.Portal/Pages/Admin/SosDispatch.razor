@page "/sos"
@using System.Globalization
@using Malume.Shared.Contracts.Auth
@using Malume.Shared.Contracts.Trips
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@attribute [Authorize(Roles = MalumeRoles.SysAdmin + "," + MalumeRoles.SchoolAdmin)]
@implements IAsyncDisposable
@inject MalumeApiClient ApiClient
@inject TokenStore TokenStore
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>SOS Emergency Dispatch Console — Malume</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-0">SOS Emergency Dispatch Console</h1>
        <div class="text-muted small">
            Real-time panic alerts &amp; resolution workflow |
            <span class="badge @(_hubConnected ? "bg-danger" : "bg-secondary")">@(_hubConnected ? "SignalR SOS Feed Live" : "Connecting...")</span>
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <div class="form-check form-switch me-2">
            <input class="form-check-input" type="checkbox" id="activeOnlySwitch" checked="@_activeOnly" @onchange="ToggleActiveOnlyAsync" />
            <label class="form-check-label small" for="activeOnlySwitch">Active Only</label>
        </div>
        <button class="btn btn-outline-primary btn-sm" @onclick="LoadIncidentsAsync" disabled="@_isLoading">Refresh</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-warning" role="alert">@_errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-success" role="alert">@_statusMessage</div>
}

<div class="card mb-3">
    <div class="card-header bg-light fw-semibold">
        Live SOS Coordinates Map (@_incidents.Count incident(s))
    </div>
    <div class="card-body p-2">
        <div id="sos-dispatch-map" style="height: 320px; border-radius: 8px;"></div>
    </div>
</div>

<div class="mb-3">
    <label class="form-label small fw-semibold" for="resolutionNotesInput">Default Resolution Notes (optional)</label>
    <input id="resolutionNotesInput" class="form-control form-control-sm" @bind="_resolutionNotes" placeholder="e.g., Security team verified learners safe with spare bus dispatched." />
</div>

@if (_isLoading)
{
    <p class="text-muted">Loading SOS incidents...</p>
}
else if (_incidents.Count == 0)
{
    <div class="alert alert-info">No SOS incidents matching the current filter.</div>
}
else
{
    <div class="row g-3">
        @foreach (SosAlertDto incident in _incidents)
        {
            string badgeClass = incident.Status switch
            {
                "Active" => "bg-danger",
                "Acknowledged" => "bg-warning text-dark",
                _ => "bg-secondary"
            };

            <div class="col-md-6">
                <div class="card @(incident.Status == "Active" ? "border-danger" : "border-secondary") h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@incident.VehicleRegistration • @incident.DriverName</strong>
                        <span class="badge @badgeClass">@incident.Status</span>
                    </div>
                    <div class="card-body small">
                        <div><strong>Triggered By:</strong> @incident.TriggeredByRole at @incident.TriggeredAtUtc.ToOffset(TimeSpan.FromHours(2)).ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) SAST</div>
                        <div><strong>Coordinates:</strong> @incident.Latitude.ToString("F5", CultureInfo.InvariantCulture), @incident.Longitude.ToString("F5", CultureInfo.InvariantCulture)</div>
                        <div><strong>Onboard Learners:</strong> @incident.OnboardLearnerCount</div>
                        @if (!string.IsNullOrWhiteSpace(incident.Notes))
                        {
                            <div><strong>Notes:</strong> @incident.Notes</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(incident.ResolutionNotes))
                        {
                            <div class="text-success mt-1"><strong>Resolution:</strong> @incident.ResolutionNotes</div>
                        }
                    </div>
                    @if (incident.Status != "Resolved" && incident.IncidentId != Guid.Empty)
                    {
                        <div class="card-footer d-flex gap-2">
                            @if (incident.Status == "Active")
                            {
                                <button class="btn btn-warning btn-sm" @onclick="() => AcknowledgeAsync(incident.IncidentId)">
                                    Acknowledge
                                </button>
                            }
                            <button class="btn btn-success btn-sm" @onclick="() => ResolveAsync(incident.IncidentId)">
                                Mark Resolved
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private readonly List<SosAlertDto> _incidents = [];
    private HubConnection? _hubConnection;
    private bool _hubConnected;
    private bool _activeOnly = true;
    private bool _isLoading = true;
    private bool _mapNeedsRender;
    private string? _errorMessage;
    private string? _statusMessage;
    private string? _resolutionNotes;

    protected override async Task OnInitializedAsync()
    {
        await LoadIncidentsAsync();
        await ConnectSignalRAsync();
    }

    private async Task ToggleActiveOnlyAsync(ChangeEventArgs args)
    {
        _activeOnly = args.Value is bool b ? b : !_activeOnly;
        await LoadIncidentsAsync();
    }

    private async Task LoadIncidentsAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            IReadOnlyList<SosAlertDto> items = await ApiClient.ListSosIncidentsAsync(_activeOnly);
            _incidents.Clear();
            _incidents.AddRange(items);
            _mapNeedsRender = true;
        }
        catch (ApiClientException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AcknowledgeAsync(Guid incidentId)
    {
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            await ApiClient.AcknowledgeSosIncidentAsync(incidentId);
            _statusMessage = $"SOS incident {incidentId} acknowledged.";
            await LoadIncidentsAsync();
        }
        catch (ApiClientException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ResolveAsync(Guid incidentId)
    {
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            await ApiClient.ResolveSosIncidentAsync(incidentId, _resolutionNotes);
            _statusMessage = $"SOS incident {incidentId} resolved.";
            await LoadIncidentsAsync();
        }
        catch (ApiClientException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ConnectSignalRAsync()
    {
        if (ApiClient.BaseAddress is null)
        {
            return;
        }

        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        Uri hubUri = new(ApiClient.BaseAddress, "/hubs/trips");
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUri, options =>
            {
                options.AccessTokenProvider = async () => (await TokenStore.GetAsync())?.AccessToken;
            })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<SosAlertDto>("SosIncidentCreated", async alert =>
        {
            _statusMessage = $"LIVE SOS ALERT: {alert.VehicleRegistration} ({alert.DriverName})";
            await LoadIncidentsAsync();
            await InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
            if (authState.User.IsInRole(MalumeRoles.SysAdmin))
            {
                await _hubConnection.InvokeAsync("JoinAdminSosGroup");
            }
            else
            {
                string? schoolClaim = authState.User.FindFirst(MalumeClaimTypes.TenantSchoolId)?.Value;
                if (Guid.TryParse(schoolClaim, out Guid schoolId))
                {
                    await _hubConnection.InvokeAsync("JoinSchoolGateGroup", schoolId);
                }
            }
            _hubConnected = true;
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"SignalR SOS feed deferred: {ex.Message}";
        }
        catch (HubException ex)
        {
            _errorMessage = $"SignalR hub notice: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapNeedsRender)
        {
            _mapNeedsRender = false;
            try
            {
                await JS.InvokeVoidAsync("malumeMap.renderSosMap", "sos-dispatch-map", _incidents);
            }
            catch (JSException)
            {
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("malumeMap.destroyMap", "sos-dispatch-map");
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
