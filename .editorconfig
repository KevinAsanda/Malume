# ==============================================================================
# Malume Platform — Code Style & Analyzer Governance
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4

# .NET / C#
[*.{cs,csx}]
indent_size = 4

# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# Prefer file-scoped namespaces and explicit clean formatting
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = false
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# var preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Language & nullability preferences
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_readonly_field = true:suggestion

# Naming conventions
dotnet_naming_rule.interfaces_should_be_pascal_case_with_i.symbols = interface
dotnet_naming_rule.interfaces_should_be_pascal_case_with_i.style = interface_pascal_case
dotnet_naming_rule.interfaces_should_be_pascal_case_with_i.severity = warning
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_style.interface_pascal_case.required_prefix = I
dotnet_naming_style.interface_pascal_case.capitalization = pascal_case

dotnet_naming_rule.types_and_members_pascal_case.symbols = public_types_and_members
dotnet_naming_rule.types_and_members_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_pascal_case.severity = suggestion
dotnet_naming_symbols.public_types_and_members.applicable_kinds = class, struct, enum, property, method, event
dotnet_naming_symbols.public_types_and_members.applicable_accessibilities = public, protected, internal
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_fields_camel_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_camel_with_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_camel_with_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_fields.required_modifiers = none
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Treat EF Core generated migrations as generated code
[**/*Migrations/**/*.cs]
generated_code = true

# Razor / Blazor
[*.{razor,cshtml}]
indent_size = 4

# MSBuild / XML
[*.{csproj,props,targets,xml,config,resx}]
indent_size = 2

# Kotlin / Gradle
[*.{kt,kts,gradle}]
indent_size = 4

# TypeScript / JavaScript / JSON / YAML
[*.{ts,tsx,js,jsx,json,yml,yaml}]
indent_size = 2
